# Required API key for /model-info and /predict (service fails closed with 503 if unset)
ML_API_KEY=replace-with-strong-random-api-key

# Paths to trained artifacts (relative to ml-service/ or absolute)
MODEL_PATH=models/model.joblib
METADATA_PATH=models/metadata.json

# Flag predictions below this probability as low_confidence=true
LOW_CONFIDENCE_THRESHOLD=0.55

# Comma-separated allowed browser origins (empty by default; wildcard * is disallowed)
CORS_ALLOWED_ORIGINS=
